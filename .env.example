# Environment variables; do not commit real credentials.
TELEGRAM_BOT_TOKEN=
ADMIN_IDS=6482147126
# 64 hexadecimal characters. Keep stable so encrypted runtime backups can be restored.
STATE_ENCRYPTION_KEY=
# Optional: protects web API write operations. Telegram admin updates do not need this key.
ADMIN_API_KEY=
DOITHEVIP_PARTNER_ID=
DOITHEVIP_PARTNER_KEY=
DOITHEVIP_WALLET=
PORT=3000
# On a persistent host, set DATA_DIR to a persistent disk directory.
# DATA_DIR=./data/runtime
